
class Solution {
    public String multiply(String num1, String num2) {

        if (num1.equals("0") || num2.equals("0")) {
            return "0";
        }

        int n = num1.length();
        int m = num2.length();

        int[] arr = new int[n + m];

        for (int i = n - 1; i >= 0; i--) {

            for (int j = m - 1; j >= 0; j--) {

                int x = num1.charAt(i) - '0';
                int y = num2.charAt(j) - '0';

                int mul = x * y;

                int sum = mul + arr[i + j + 1];

                arr[i + j + 1] = sum % 10;
                arr[i + j] = arr[i + j] + sum / 10;
            }
        }

        String ans = "";

        for (int i = 0; i < arr.length; i++) {

            if (ans.length() == 0 && arr[i] == 0) {
                continue;
            }

            ans = ans + arr[i];
        }

        return ans;
    }
}

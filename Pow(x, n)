
class Solution {
    public double myPow(double x, int n) {

        long num = n;

        if (num < 0) {
            x = 1 / x;
            num = -num;
        }

        double result = 1;

        while (num > 0) {
            result = result * x;
            num--;
        }

        return result;
    }
}
